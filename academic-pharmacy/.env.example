# Copia a academic-pharmacy/.env (ignorado por Git) para personalizar el
# entorno local de Docker Compose. Ningún valor se comparte con el sistema
# clínico Kay Care Enfermería.

# Contraseña del PostgreSQL local (solo Docker).
PHARMACY_DB_PASSWORD=

# Clave de Laravel. Genera una con:
#   docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# Si se deja vacía, el contenedor crea una efímera en cada arranque.
PHARMACY_APP_KEY=

# Cuenta administradora de la tienda demo.
PHARMACY_ADMIN_EMAIL=admin@farmacia.demo
# Si se deja vacía, el seeder genera una contraseña aleatoria y la muestra
# una sola vez en los logs del backend (docker compose logs backend).
PHARMACY_ADMIN_PASSWORD=
