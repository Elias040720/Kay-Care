# Kay Care Farmacia — API académica (NO compartir valores con el sistema clínico)
APP_NAME="Kay Care Farmacia"
APP_ENV=local
# Genera con: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Base de datos PROPIA de la farmacia (PostgreSQL).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kaycare_pharmacy
DB_USERNAME=pharmacy_app
DB_PASSWORD=
DB_SSLMODE=prefer

# Sesión de administrador: cookie propia, distinta a la del sistema clínico.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_COOKIE=kcf_pharmacy_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8088,localhost:5174,127.0.0.1:8088
PHARMACY_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5174
TRUSTED_PROXIES=127.0.0.1

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

RATE_LIMIT_STORE=120
RATE_LIMIT_CHECKOUT=10
RATE_LIMIT_ADMIN=240
RATE_LIMIT_LOGIN=5

# Cuenta administradora inicial (la contraseña nunca se versiona).
PHARMACY_ADMIN_NAME="Administración Demo"
PHARMACY_ADMIN_EMAIL=admin@farmacia.demo
PHARMACY_ADMIN_PASSWORD=
