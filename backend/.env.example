# ---------------------------------------------------------------------------
# Kay Care backend — example environment (DEMO / local development)
# Copy to .env and run: php artisan key:generate
# NEVER commit a real .env. NEVER put real patient data in a demo database.
# ---------------------------------------------------------------------------

APP_NAME="Kay Care"
APP_ENV=local
APP_KEY=
# Must be false in any deployment. Stack traces are only shown when true.
APP_DEBUG=true
# Use "localhost" (not 127.0.0.1) on BOTH servers to keep cookies consistent.
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Kay Care domain --------------------------------------------------------
# demo: fictitious data + DEMO catalog. The demo seeder refuses other values.
KAYCARE_MODE=demo
KAYCARE_TIMEZONE=America/Lima

# --- SPA (Vue) / Sanctum / CORS ----------------------------------------------
# Exact SPA origin(s) allowed by CORS (comma separated, no wildcards).
FRONTEND_URL=http://localhost:5173
# Hosts (with port) that receive stateful cookie authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# --- Database ----------------------------------------------------------------
# Development: SQLite (file database/database.sqlite).
DB_CONNECTION=sqlite
# Future MySQL 8 deployment (uncomment and fill):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kaycare
# DB_USERNAME=kaycare
# DB_PASSWORD=

# --- Sessions ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
# Keep null for localhost. In production set the parent domain (e.g. .example.org).
SESSION_DOMAIN=null
# Must be true behind HTTPS in any deployment.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Demo accounts (read only by the demo seeder) ----------------------------
# Leave empty to skip. Passwords must have >= 12 characters. Use fictitious
# addresses (e.g. *.test) and never reuse real passwords.
DEMO_NURSE_NAME="Enfermera Demo"
DEMO_NURSE_EMAIL=
DEMO_NURSE_PASSWORD=
DEMO_ADMIN_NAME="Administrador Demo"
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
