<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Windows PHP also exposes inherited environment in $_SERVER; dotenv reads it first. -->
        <server name="APP_ENV" value="testing"/>
        <server name="APP_KEY" value="base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="/>
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-config-never.php"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="KAYCARE_MODE" value="demo"/>
        <server name="KAYCARE_TIMEZONE" value="America/Lima"/>
        <server name="APP_URL" value="http://localhost:8000"/>
        <server name="FRONTEND_URL" value="http://localhost:5173"/>
        <server name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173,localhost:8000"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=" force="true"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-config-never.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="KAYCARE_MODE" value="demo" force="true"/>
        <env name="KAYCARE_TIMEZONE" value="America/Lima" force="true"/>
        <env name="APP_URL" value="http://localhost:8000" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost:5173" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173,localhost:8000" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
